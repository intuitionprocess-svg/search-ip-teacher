# Copy this file to .env.local and fill in your values

# 1. Get a Google API key at https://console.cloud.google.com
#    Enable the "Google Sheets API" for that project.
GOOGLE_SHEETS_API_KEY=your_google_api_key_here

# 2. Your spreadsheet ID — found in the Google Sheets URL:
#    https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# 3. The sheet tab name and column range (default covers columns A–K)
#    Change "Sheet1" if your tab has a different name.
GOOGLE_SHEET_RANGE=Sheet1!A:K
